<apex:page showHeader="false" sidebar="false" standardStylesheets="false"
           applyHtmlTag="false" applyBodyTag="false" docType="html-5.0"
           controller="CurbCutWeb" title="Ask | Curb Cut">
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Find out what you could ask for at work. No phone, no account, and you never have to say what condition you have."/>
  <title>Ask | Curb Cut</title>
  <style>
    /* One question on the first screen. Everything else waits behind a plain
       button until it's wanted, so the page reads as one thing at a time. */
    details.fold { margin: 1.4rem 0 0; }
    details.fold > summary {
      list-style: none; cursor: pointer; display: flex; align-items: center; gap: .7rem;
      min-height: 48px; padding: .7rem .9rem; border: 1.5px solid var(--line, #C9C9C1);
      border-radius: 6px; background: var(--surface, #fff); font-weight: 700; color: var(--ink, #14171A);
    }
    details.fold > summary::-webkit-details-marker { display: none; }
    details.fold > summary::before { content: "+"; font-family: ui-monospace, monospace; font-size: 1.2rem; line-height: 1; width: 1.1rem; text-align: center; }
    details.fold[open] > summary::before { content: "\2013"; }
    details.fold > summary:focus-visible { outline: 3px solid #0B57C7; outline-offset: 3px; box-shadow: 0 0 0 3px var(--ground, #F5F3ED); }
    details.fold > .foldBody { padding: 1rem .2rem 0; }
    .copyRow { display: flex; gap: .7rem; align-items: center; flex-wrap: wrap; margin-top: .5rem; }
  </style>
</head>
<body>
<c:CurbCutShell pageTitle="Ask" current="ask"
  eyebrow="No phone, no account, and nothing kept about who you are."
  heading="Tell me what's hard right now."
  lede="In your own words. You don't have to say why it's hard, only what is.">

  <ol class="rail" id="rail" aria-label="Where you are">
    <li data-state="now"><span class="n">1</span>Say what's hard<span class="vh"> - you are here</span></li>
    <li data-state="todo"><span class="n">2</span>See what you could ask for<span class="vh"> - not started</span></li>
    <li data-state="todo"><span class="n">3</span>Read a draft<span class="vh"> - not started</span></li>
    <li data-state="todo"><span class="n">4</span>Decide whether to send<span class="vh"> - not started</span></li>
  </ol>

  <p class="sentinel" id="sentinel" data-sent="no">
    <span class="dot" aria-hidden="true"></span>
    <span id="sentinelText">Nothing has been sent to anyone. Only you can send it, on a later screen, with a button you press yourself.</span>
  </p>

  <section aria-labelledby="askHeading">
    <h2 id="askHeading" class="vh">Say what's hard</h2>
    <form id="askForm">
      <label for="need" class="fieldLabel">What's hard at work right now?</label>
      <p id="needHelp" class="fieldHelp">Tap one of these, or write your own. You can change it after.</p>
      <ul class="starters" id="starters" aria-label="Common starting points. Choosing one fills the box, and you can change it.">
        <li><button type="button">I keep missing things in meetings</button></li>
        <li><button type="button">Typing hurts after a while</button></li>
        <li><button type="button">The noise in the office is too much</button></li>
        <li><button type="button">I can't use the phone</button></li>
        <li><button type="button">I need to change my hours</button></li>
        <li><button type="button">My back hurts by the afternoon</button></li>
      </ul>
      <textarea id="need" name="need" rows="4" aria-describedby="needHelp"></textarea>

      <div class="actions">
        <button type="submit" id="go" class="btn primary">Show me what I could ask for</button>
        <button type="button" id="wantHuman" class="btn">I'd rather talk to a person</button>
      </div>
    </form>

    <!-- Announced to screen readers as it changes, without stealing focus. -->
    <div id="status" role="status" aria-live="polite" aria-atomic="true" class="statusLine"></div>

    <!-- Showing instead of telling. It sits after the buttons, behind one
         plain control, so nobody has to tab through two file pickers to reach
         the button, and the first screen stays one question. -->
    <details class="fold showme" id="showme">
      <summary>Can't put it into words? Send a photo or a short video instead</summary>
      <div class="foldBody">
        <p class="fieldHelp">
          A photo of your desk, your screen or your chair is often easier than describing it.
          If you sign, send a video. A person will watch it. No machine will ever caption it or guess what's in it.
        </p>
        <div class="uploads">
          <div class="upload">
            <label for="photoFile" class="fieldLabel">Send a photo</label>
            <p id="photoHelp" class="fieldHelp">Your workstation, your screen, whatever shows it.</p>
            <input type="file" id="photoFile" accept="image/*" aria-describedby="photoHelp"/>
          </div>
          <div class="upload">
            <label for="videoFile" class="fieldLabel">Send a video</label>
            <p id="videoHelp" class="fieldHelp">Signed, spoken, or just pointing at the thing.</p>
            <input type="file" id="videoFile" accept="video/*" aria-describedby="videoHelp"/>
          </div>
        </div>
        <p class="fine" style="margin-top:.4rem">Up to about four megabytes. If a file's too big, a shorter clip works, and so does telling me in words.</p>
      </div>
    </details>
    <div id="mediaStatus" role="status" aria-live="polite" aria-atomic="true" class="statusLine"></div>
  </section>

  <section id="results" hidden="hidden" aria-labelledby="resultsHeading">
    <h2 id="resultsHeading">What other people have asked for</h2>
    <div id="optionsBox" class="optionsBox"></div>
    <div class="actions">
      <button type="button" id="draftBtn" class="btn primary">Help me ask for one of these</button>
      <button type="button" id="stopHere" class="btn">I just wanted to know. Stop here.</button>
    </div>
  </section>

  <section id="draftSection" hidden="hidden" aria-labelledby="draftHeading">
    <h2 id="draftHeading">Read this over</h2>
    <p>Nothing has been sent. This is only a draft, and only you can send it.</p>
    <div id="draftBox" class="draftBox"></div>
    <div class="actions">
      <button type="button" id="sendBtn" class="btn primary">Yes, send this</button>
      <button type="button" id="deleteBtn" class="btn">Delete it</button>
    </div>
  </section>

  <section id="doneSection" hidden="hidden" aria-labelledby="doneHeading">
    <h2 id="doneHeading">Done</h2>
    <div id="doneBox" class="doneBox"></div>
  </section>

  <!-- Separate from the request above, and folded away until it's wanted. -->
  <section id="standingSection" aria-labelledby="standingHeading">
    <details class="fold" id="standingFold">
      <summary id="standingHeading">Something that'll still be true next month? Say it once, instead of to every new manager</summary>
      <div class="foldBody">
        <p>
          If something about how you work is going to be true next month as well as today,
          you can have it remembered and shown to the people you choose. It stays in your words.
          You pick exactly who sees it, you can see everyone who's been shown it, and you can
          turn it off in one press without being asked why.
        </p>

        <form id="standingForm" onsubmit="return false;">
          <label for="statement" class="fieldLabel">What should be remembered?</label>
          <p id="statementHelp" class="fieldHelp">For example: please face me when you speak, or please send an agenda before meetings.</p>
          <textarea id="statement" name="statement" rows="3" aria-describedby="statementHelp"></textarea>

          <label for="sharedWith" class="fieldLabel">Who should see it?</label>
          <p id="sharedHelp" class="fieldHelp">Only these people. Nobody else is told.</p>
          <select id="sharedWith" class="picker" aria-describedby="sharedHelp">
            <option value="Manager only">My manager only</option>
            <option value="Meeting hosts">Whoever runs a meeting I'm in</option>
            <option value="My team">My team</option>
          </select>

          <label for="scope" class="fieldLabel">When does it apply?</label>
          <select id="scope" class="picker">
            <option value="Always">Always</option>
            <option value="Meetings">In meetings</option>
            <option value="This team">On this team</option>
            <option value="This manager">With this manager</option>
          </select>

          <div class="actions">
            <button type="button" id="saveStanding" class="btn primary">Remember this</button>
          </div>
        </form>

        <div id="standingStatus" role="status" aria-live="polite" aria-atomic="true" class="statusLine"></div>

        <div id="standingSaved" hidden="hidden">
          <div id="standingBox" class="doneBox"></div>

          <!-- The code is the only thing connecting an anonymous person to what they
               just saved. Close this tab without it and the preference cannot be
               turned off from anywhere, which would leave someone able to switch a
               disclosure on and not off. -->
          <div id="codeBox" class="codeBox">
            <h3 class="codeLabel" id="codeHeading">Your code</h3>
            <p id="codeValue" class="codeValue"></p>
            <div class="copyRow">
              <button type="button" id="copyCode" class="btn">Copy the code</button>
            </div>
            <p class="codeHelp">
              Keep this somewhere safe. Send <strong>OFF</strong> and your code, here, by text, or by email,
              and it's turned off. Send <strong>WHO</strong> and your code to see everyone who's been shown it.
              I can't look you up, because I don't know who you are.
            </p>
          </div>

          <div class="actions">
            <button type="button" id="whoBtn" class="btn">Who has been shown this?</button>
            <button type="button" id="offBtn" class="btn">Turn it off</button>
          </div>
          <div id="whoBox" class="optionsBox" hidden="hidden"></div>
        </div>
      </div>
    </details>
  </section>

</c:CurbCutShell>

<script type="text/javascript">
(function () {
  'use strict';
  var need = document.getElementById('need');
  var status = document.getElementById('status');
  var results = document.getElementById('results');
  var optionsBox = document.getElementById('optionsBox');
  var draftSection = document.getElementById('draftSection');
  var draftBox = document.getElementById('draftBox');
  var doneSection = document.getElementById('doneSection');
  var doneBox = document.getElementById('doneBox');

  var barrierId = null, draftText = null, chosen = null;

  var railItems = document.getElementById('rail').getElementsByTagName('li');
  var sentinel = document.getElementById('sentinel');
  var sentinelText = document.getElementById('sentinelText');

  /* The rail is set from one place so it can never disagree with the sections
     that are actually visible. State is carried by fill, by the numeral, and
     by words only a screen reader hears, never by colour on its own. */
  function step(current) {
    for (var i = 0; i < railItems.length; i++) {
      var n = i + 1, li = railItems[i], vh = li.getElementsByTagName('span')[1];
      var state = n < current ? 'done' : (n === current ? 'now' : 'todo');
      li.setAttribute('data-state', state);
      vh.textContent = state === 'done' ? ' - done'
                     : state === 'now'  ? ' - you are here'
                     : ' - not started';
    }
  }

  /* Stays true for the whole session rather than being a sentence someone
     read once at the top and then stopped believing. */
  function markSent() {
    sentinel.setAttribute('data-sent', 'yes');
    sentinelText.textContent = 'A request was sent, because you approved it.';
  }

  function say(msg) { status.textContent = msg; }

  /* Disabling the button a person just pressed drops keyboard focus onto the
     page body, which a screen reader reads as nothing. So focus is handed to
     the status line while the work happens, and given back afterwards. */
  function busy(on, btn, label) {
    btn.disabled = on;
    btn.setAttribute('aria-busy', on ? 'true' : 'false');
    if (on) {
      status.setAttribute('tabindex', '-1');
      if (document.activeElement === btn) { status.focus(); }
    } else {
      if (label) { btn.textContent = label; }
      if (document.activeElement === status || document.activeElement === document.body) { btn.focus(); }
    }
  }
  function show(el) { el.hidden = false; }
  function hide(el) { el.hidden = true; }
  function focusHeading(id) {
    var h = document.getElementById(id);
    h.setAttribute('tabindex', '-1');
    h.focus();
  }

  function remote(fn, args, onOk) {
    Visualforce.remoting.Manager.invokeAction(fn, ...args, function (res, ev) {
      if (ev.status && res) { onOk(res); }
      else {
        say('Something went wrong on my end, and that isn\'t your problem to solve. ' +
            'Try again, or ask for a person.');
      }
    }, { escape: false, timeout: 30000 });
  }

  /* The form submits, so Enter in the box does what the button does. */
  function ask() {
    var text = need.value.trim();
    if (!text) { say('Tell me what\'s hard, in your own words.'); need.focus(); return; }
    var b = document.getElementById('go'); busy(true, b); say('Looking up what other people have asked for...');
    remote('{!$RemoteAction.CurbCutWeb.consult}', [text], function (r) {
      busy(false, b);
      barrierId = r.barrierId;
      say(r.message);
      optionsBox.textContent = r.noMatch ? '' : r.options;
      optionsBox.hidden = !!r.noMatch;
      show(results); step(2);
      focusHeading('resultsHeading');
    });
  }
  document.getElementById('askForm').addEventListener('submit', function (e) { e.preventDefault(); ask(); });
  need.addEventListener('keydown', function (e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); ask(); }
  });

  document.getElementById('draftBtn').addEventListener('click', function () {
    var b = this; busy(true, b); say('Putting that into words...');
    remote('{!$RemoteAction.CurbCutWeb.draft}', [need.value.trim(), chosen], function (r) {
      busy(false, b);
      draftText = r.draft;
      draftBox.textContent = r.draft;
      say(r.message);
      show(draftSection); step(3);
      focusHeading('draftHeading');
    });
  });

  document.getElementById('sendBtn').addEventListener('click', function () {
    var b = this; busy(true, b); say('Sending it...');
    remote('{!$RemoteAction.CurbCutWeb.send}', [draftText, true, barrierId], function (r) {
      busy(false, b);
      doneBox.textContent = r.message;
      say(r.message);
      hide(draftSection); show(doneSection); step(5); markSent();
      focusHeading('doneHeading');
    });
  });

  document.getElementById('deleteBtn').addEventListener('click', function () {
    draftText = null; draftBox.textContent = ''; hide(draftSection); step(2);
    say('Deleted. Nothing was sent. You can start again whenever you want.');
    focusHeading('resultsHeading');
  });

  document.getElementById('stopHere').addEventListener('click', function () {
    say('That\'s fine. Knowing is allowed, and asking is optional. Nothing has been sent to anyone.');
  });

  /* ---------- showing instead of telling ---------- */
  var mediaStatus = document.getElementById('mediaStatus');
  function sayMedia(m) { mediaStatus.textContent = m; }

  function sendFile(input, kind, label) {
    var file = input.files && input.files[0];
    if (!file) { return; }
    if (file.size > 4 * 1024 * 1024) {
      sayMedia('That ' + label + ' is bigger than about four megabytes, which is all '
             + 'I can take here. A shorter clip or a smaller photo will work, and so '
             + 'will telling me in words.');
      input.value = '';
      return;
    }
    sayMedia(kind === 'Video'
      ? 'Sending your video. It goes to a person, never to a machine.'
      : 'Sending your photo.');

    var reader = new FileReader();
    reader.onerror = function () {
      sayMedia('I couldn\'t read that file, and that isn\'t your problem to solve. Try again, or tell me in words.');
    };
    reader.onload = function () {
      var b64 = String(reader.result || '');
      var comma = b64.indexOf(',');
      if (comma > -1) { b64 = b64.slice(comma + 1); }
      remote('{!$RemoteAction.CurbCutWeb.sendMedia}', [barrierId, file.name, b64, kind],
        function (r) {
          sayMedia(r.message);
          if (r.accepted) {
            barrierId = r.barrierId;
            input.value = '';
            if (r.interpreter) { step(2); }
          }
        });
    };
    reader.readAsDataURL(file);
  }

  document.getElementById('photoFile').addEventListener('change', function () {
    sendFile(this, 'Image', 'photo');
  });
  document.getElementById('videoFile').addEventListener('change', function () {
    sendFile(this, 'Video', 'video');
  });

  /* ---------- standing preferences ---------- */
  var stStatus = document.getElementById('standingStatus');
  var stSaved  = document.getElementById('standingSaved');
  var stBox    = document.getElementById('standingBox');
  var whoBox   = document.getElementById('whoBox');
  var prefId   = null;

  function saySt(msg) { stStatus.textContent = msg; }

  document.getElementById('saveStanding').addEventListener('click', function () {
    var text = document.getElementById('statement').value.trim();
    if (!text) {
      saySt('Write what you\'d like remembered, in your own words.');
      document.getElementById('statement').focus();
      return;
    }
    var b = this; busy(true, b); saySt('Saving it in your words...');
    remote('{!$RemoteAction.CurbCutWeb.saveStanding}',
      [text, document.getElementById('scope').value,
       document.getElementById('sharedWith').value, true],
      function (r) {
        busy(false, b);
        saySt(r.message);
        if (r.created) {
          prefId = r.preferenceId;
          stBox.textContent = text;
          var code = r.claimCode || '';
          var cv = document.getElementById('codeValue');
          cv.textContent = code;
          /* A screen reader reads a six letter code as a word. Letter by letter is
             what somebody needs in order to write it down. */
          cv.setAttribute('aria-label', 'Your code, letter by letter: ' + code.split('').join(' '));
          show(stSaved);
          /* Every other async update moves focus to its heading. This one set the
             tabindex and then never called focus(), so the single moment that
             matters most -- a code shown exactly once, which somebody has to
             write down -- left a screen-reader user exactly where they were. */
          var codeH = document.getElementById('codeHeading');
          codeH.setAttribute('tabindex', '-1');
          codeH.focus();
        }
      });
  });

  document.getElementById('copyCode').addEventListener('click', function () {
    var code = document.getElementById('codeValue').textContent || '';
    if (!code) { return; }
    var done = function () { saySt('Copied. Your code is ' + code.split('').join(' ') + '.'); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(done, function () { fallback(); });
    } else { fallback(); }
    function fallback() {
      var r = document.createRange(); r.selectNodeContents(document.getElementById('codeValue'));
      var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
      try { document.execCommand('copy'); done(); } catch (e) { saySt('Select the code and copy it yourself.'); }
    }
  });

  document.getElementById('whoBtn').addEventListener('click', function () {
    if (!prefId) { return; }
    var b = this; busy(true, b); saySt('Looking up who has been shown it...');
    remote('{!$RemoteAction.CurbCutWeb.whoSaw}', [prefId], function (r) {
      busy(false, b);
      saySt(r.message);
      whoBox.textContent = r.shownTo || '';
      whoBox.hidden = !r.shownTo;
      focusHeading('standingHeading');
    });
  });

  document.getElementById('offBtn').addEventListener('click', function () {
    if (!prefId) { return; }
    var b = this; busy(true, b); saySt('Turning it off...');
    remote('{!$RemoteAction.CurbCutWeb.revokeStanding}', [prefId], function (r) {
      busy(false, b);
      saySt(r.message + ' You weren\'t asked why, and there\'s nowhere to record a reason.');
      hide(stSaved);
      prefId = null;
      focusHeading('standingHeading');
    });
  });

  /* Tapping a starter fills the box and leaves the cursor in it, so it's a
     starting point rather than a menu of approved answers. */
  var starterBtns = document.getElementById('starters').getElementsByTagName('button');
  for (var si = 0; si < starterBtns.length; si++) {
    starterBtns[si].addEventListener('click', function () {
      need.value = this.textContent;
      need.focus();
      try { need.setSelectionRange(need.value.length, need.value.length); } catch (e) {}
      say('Filled in for you. Change any of it, or press the button below.');
    });
  }

  document.getElementById('wantHuman').addEventListener('click', function () {
    var b = this; busy(true, b); say('Getting a person for you...');
    remote('{!$RemoteAction.CurbCutWeb.human}', [need.value.trim(), barrierId], function (r) {
      busy(false, b);
      doneBox.textContent = r.message + (r.handlerName ? ' You\'re being picked up by ' + r.handlerName + '.' : '');
      say(r.message);
      show(doneSection);
      focusHeading('doneHeading');
    });
  });
})();
</script>
</body>
</html>
</apex:page>
