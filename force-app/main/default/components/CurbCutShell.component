<script>
/* Reader preferences persist, because someone who needs bigger text should
   set it once and not think about it again. Everything is wrapped: a browser
   with storage disabled must still get a working page. */
(function () {
  var root = document.documentElement;
  var sizeBtn = document.getElementById('tsize');
  var conBtn  = document.getElementById('tcon');
  var STEPS = [1, 1.15, 1.3];
  var LABEL = ['A+', 'A++', 'A'];
  var i = 0, contrast = false;

  function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

  function applySize() {
    root.style.setProperty('--step', STEPS[i]);
    sizeBtn.textContent = LABEL[i];
    sizeBtn.setAttribute('aria-pressed', i > 0 ? 'true' : 'false');
    sizeBtn.setAttribute('title', i === 2 ? 'Back to normal text size' : 'Make the text bigger');
  }
  function applyContrast() {
    if (contrast) { root.setAttribute('data-contrast', 'more'); }
    else { root.removeAttribute('data-contrast'); }
    conBtn.setAttribute('aria-pressed', contrast ? 'true' : 'false');
  }

  var s = parseInt(get('cc-size'), 10); if (!isNaN(s) && s >= 0 && s < STEPS.length) { i = s; }
  contrast = get('cc-contrast') === '1';
  applySize(); applyContrast();

  sizeBtn.addEventListener('click', function () {
    i = (i + 1) % STEPS.length; set('cc-size', i); applySize();
  });
  conBtn.addEventListener('click', function () {
    contrast = !contrast; set('cc-contrast', contrast ? '1' : '0'); applyContrast();
  });
})();
</script>
</apex:component>
