<apex:component id="CurbCutShell">
<apex:attribute name="pageTitle" type="String" description="Title for this page" required="true"/>
<apex:attribute name="eyebrow" type="String" description="Small label above the heading" required="false"/>
<apex:attribute name="heading" type="String" description="Main heading" required="true"/>
<apex:attribute name="lede" type="String" description="Opening sentence under the heading" required="false"/>
<apex:attribute name="current" type="String" description="Which nav item is current" required="false"/>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
<!-- One request per family. A single combined URL needs ampersands, and
     Visualforce double-encodes them to &amp;#38; which silently breaks every
     family after the first. The body face is an accessibility decision, so
     it must actually arrive. -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400"/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;800"/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500"/>

<style>
/* ------------------------------------------------------------------
   Curb Cut

   The site argues that process is a barrier, so the site must not be
   one. Every choice here is load bearing:

   - Humanist sans for body text, not a serif. Easier at small sizes,
     easier with low vision, easier with dyslexia.
   - Colour never carries meaning alone. Every state also has a word,
     a weight, or a shape, so it survives any colour vision.
   - Body contrast targets WCAG AAA, not AA.
   - Reader controls persist. Someone who needs larger text should set
     it once, not on every page.
   ------------------------------------------------------------------ */

:root {
  --ground:#F2F1ED; --raised:#FBFAF7; --sunk:#E5E3DC;
  --ink:#14171A;            /* 15.8:1 on ground - AAA */
  --ink-soft:#41474A;       /* 8.9:1  on ground - AAA */
  --ink-mute:#5E6568;       /* 5.9:1  on ground - AA large, labels only */
  --line:#C8C6BC; --line-firm:#8E8C82;
  --signal:#8A5D0F;         /* ochre, 5.6:1 - never alone, always with text */
  --signal-bg:#F5E7CC;
  --deep:#1F5A4E;           /* teal, 6.8:1 */
  --deep-bg:#D9E9E4;
  --alert:#8C2F26;          /* 7.2:1 */
  --alert-bg:#F6DFDC;
  --focus:#0B57C7;
  --measure:64ch;
  --step:1;                 /* reader text-size multiplier */
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --ground:#0F1214; --raised:#181C1E; --sunk:#080A0B;
    --ink:#EDEEEA; --ink-soft:#BFC4C2; --ink-mute:#8E9593;
    --line:#2C3133; --line-firm:#4C5457;
    --signal:#E5B15A; --signal-bg:#2E2413;
    --deep:#63B7A3; --deep-bg:#102B26;
    --alert:#E08B82; --alert-bg:#331916;
    --focus:#7FB0FF;
  }
}
:root[data-theme="dark"] {
  --ground:#0F1214; --raised:#181C1E; --sunk:#080A0B;
  --ink:#EDEEEA; --ink-soft:#BFC4C2; --ink-mute:#8E9593;
  --line:#2C3133; --line-firm:#4C5457;
  --signal:#E5B15A; --signal-bg:#2E2413;
  --deep:#63B7A3; --deep-bg:#102B26;
  --alert:#E08B82; --alert-bg:#331916;
  --focus:#7FB0FF;
}
/* Honour an OS request for more contrast. */
@media (prefers-contrast: more) {
  :root { --ink-soft:var(--ink); --ink-mute:var(--ink); --line:var(--line-firm); }
}
:root[data-contrast="more"] { --ink-soft:var(--ink); --ink-mute:var(--ink); --line:var(--line-firm); }

*, *::before, *::after { box-sizing:border-box; }

html { -webkit-text-size-adjust:100%; }
body {
  margin:0; background:var(--ground); color:var(--ink);
  font-family:"Source Sans 3","Segoe UI",system-ui,-apple-system,sans-serif;
  font-size:calc(1.125rem * var(--step));
  line-height:1.65; -webkit-font-smoothing:antialiased;
}

/* Keyboard users must always be able to reach the content first. */
.skip {
  position:absolute; left:-9999px; top:0; z-index:100;
  background:var(--ink); color:var(--ground); padding:14px 20px;
  font-weight:700; text-decoration:none; border-radius:0 0 4px 0;
}
.skip:focus { left:0; }

/* A focus ring you cannot miss, on any background. */
a:focus-visible, button:focus-visible, [tabindex]:focus-visible {
  outline:3px solid var(--focus); outline-offset:3px; border-radius:2px;
}

.wrap { max-width:calc(var(--measure) + 8rem); margin:0 auto; padding:0 clamp(1rem,5vw,3rem); }
.measure { max-width:var(--measure); }

/* ---------- masthead ---------- */
.top {
  border-bottom:1px solid var(--line); background:var(--raised);
  position:sticky; top:0; z-index:20;
}
.top-in {
  max-width:calc(var(--measure) + 8rem); margin:0 auto;
  padding:.75rem clamp(1rem,5vw,3rem);
  display:flex; flex-wrap:wrap; gap:.75rem 1.5rem; align-items:center;
}
.brand {
  display:flex; align-items:center; gap:.6rem; text-decoration:none; color:var(--ink);
  font-family:Archivo,system-ui,sans-serif; font-weight:800; font-size:1.15rem;
  letter-spacing:-.02em; margin-right:auto; padding:.25rem 0;
}
.brand:hover .mark-cut { transform:translateX(2px); }
.nav { display:flex; gap:.25rem; flex-wrap:wrap; }
.nav a {
  color:var(--ink-soft); text-decoration:none; font-weight:600; font-size:.95rem;
  padding:.6rem .7rem; border-radius:4px; min-height:44px; display:flex; align-items:center;
}
.nav a:hover { background:var(--sunk); color:var(--ink); }
/* Current page is marked by weight and an underline, not by colour alone. */
.nav a[aria-current="page"] {
  color:var(--ink); font-weight:700; box-shadow:inset 0 -3px 0 var(--signal);
}

/* ---------- reader controls ---------- */
.tools { display:flex; gap:.4rem; align-items:center; }
.tools button {
  font:inherit; font-size:.85rem; font-weight:700; font-family:Archivo,sans-serif;
  min-height:44px; min-width:44px; padding:.4rem .7rem; cursor:pointer;
  background:var(--ground); color:var(--ink-soft);
  border:1px solid var(--line-firm); border-radius:4px;
}
.tools button:hover { background:var(--sunk); color:var(--ink); }
.tools button[aria-pressed="true"] {
  background:var(--ink); color:var(--ground); border-color:var(--ink);
}

/* ---------- type ---------- */
h1,h2,h3 { font-family:Archivo,system-ui,sans-serif; letter-spacing:-.025em; text-wrap:balance; }
h1 { font-size:clamp(2.1rem,6vw,3.4rem); font-weight:800; line-height:1.03; margin:0; }
h2 { font-size:clamp(1.35rem,3vw,1.75rem); font-weight:700; line-height:1.2; margin:0 0 .6rem; }
h3 { font-size:1.05rem; font-weight:700; margin:0 0 .3rem; }
p { margin:0 0 1.1rem; max-width:var(--measure); }
ul,ol { margin:0 0 1.1rem; padding-left:1.3rem; max-width:var(--measure); }
li { margin-bottom:.55rem; }
a { color:var(--ink); text-decoration-thickness:2px; text-underline-offset:3px; }
a:hover { text-decoration-thickness:3px; }
strong,b { font-weight:700; }

header.page { padding:clamp(2.5rem,7vh,4.5rem) 0 0; }
.eyebrow {
  font-family:"JetBrains Mono",ui-monospace,monospace; font-size:.75rem;
  letter-spacing:.14em; text-transform:uppercase; color:var(--ink-mute);
  margin:0 0 1rem;
}
.lede { font-size:clamp(1.15rem,2.4vw,1.35rem); color:var(--ink-soft); margin:1.2rem 0 0; max-width:38ch; }
.hr { height:4px; background:var(--ink); margin:2.2rem 0 0; }
section { margin-top:2.8rem; }

/* ---------- plain-language summary ---------- */
/* Legal documents are inaccessible by construction. Saying the same thing
   in plain words first is the curb cut applied to the policy itself. */
.plain {
  background:var(--deep-bg); border:1px solid var(--deep);
  border-left-width:5px; border-radius:5px; padding:1.15rem 1.35rem; margin:0 0 1.6rem;
}
.plain .tag {
  font-family:Archivo,sans-serif; font-size:.75rem; font-weight:700;
  letter-spacing:.1em; text-transform:uppercase; color:var(--deep);
  display:block; margin-bottom:.5rem;
}
.plain p { margin-bottom:.5rem; }
.plain p:last-child { margin-bottom:0; }

.note {
  background:var(--raised); border:1px solid var(--line); border-left:5px solid var(--signal);
  border-radius:5px; padding:1.15rem 1.35rem; margin:0 0 1.6rem;
}
.note.absent { border-left-color:var(--alert); background:var(--alert-bg); }
.note p:last-child { margin-bottom:0; }

/* ---------- facts table ---------- */
.facts { width:100%; border-collapse:collapse; margin:0 0 1.2rem; }
.facts th, .facts td { text-align:left; padding:.85rem .9rem .85rem 0; border-bottom:1px solid var(--line); vertical-align:top; }
.facts th {
  font-family:Archivo,sans-serif; font-size:.78rem; letter-spacing:.07em;
  text-transform:uppercase; color:var(--ink-mute); font-weight:700; width:36%;
}
@media (max-width:34rem) {
  .facts th, .facts td { display:block; width:100%; }
  .facts th { border-bottom:0; padding-bottom:.15rem; }
}

/* ---------- keyword chips ---------- */
.kw {
  font-family:"JetBrains Mono",ui-monospace,monospace; font-size:.85em; font-weight:500;
  background:var(--sunk); border:1px solid var(--line); padding:.1rem .45rem;
  border-radius:3px; white-space:nowrap;
}
.kwlist { list-style:none; padding:0; }
.kwlist li { display:flex; gap:.75rem; align-items:baseline; }

/* ---------- the mark ---------- */
/* A kerb with a cut in it. Drawn, not an image file, so it stays sharp,
   scales with text, and needs no alt text beyond the name beside it. */
.mark { flex:0 0 auto; }
.mark-cut { transition:transform .18s ease; }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation:none !important; transition:none !important; }
}

footer.page {
  margin-top:4rem; padding:2.2rem 0 4rem; border-top:4px solid var(--ink);
  color:var(--ink-soft); font-size:.95rem;
}
/* ---------- the ask flow ---------- */
.fieldLabel {
  display:block; font-family:Archivo,system-ui,sans-serif; font-weight:700;
  font-size:1.1rem; margin-bottom:.3rem;
}
.fieldHelp { color:var(--ink-soft); font-size:.95rem; margin:0 0 .6rem; }
textarea {
  width:100%; font:inherit; font-size:1.05rem; line-height:1.55; padding:.8rem .9rem;
  background:var(--raised); color:var(--ink);
  border:2px solid var(--line-firm); border-radius:5px; resize:vertical;
}
textarea:focus-visible { outline:3px solid var(--focus); outline-offset:2px; }
.actions { display:flex; flex-wrap:wrap; gap:.6rem; margin-top:1rem; }
.btn {
  font:inherit; font-family:Archivo,system-ui,sans-serif; font-weight:700; font-size:1rem;
  min-height:48px; padding:.7rem 1.15rem; cursor:pointer; border-radius:5px;
  background:var(--raised); color:var(--ink); border:2px solid var(--line-firm);
}
.btn:hover { background:var(--sunk); }
.btn.primary { background:var(--ink); color:var(--ground); border-color:var(--ink); }
.btn.primary:hover { opacity:.9; }
.btn[disabled] { opacity:.55; cursor:progress; }
/* Status is announced to screen readers; sighted users get a visible line too. */
.statusLine {
  margin-top:1.1rem; font-size:1.02rem; color:var(--ink); min-height:1.6em;
  border-left:5px solid var(--deep); background:var(--deep-bg);
  padding:.75rem .95rem; border-radius:0 5px 5px 0;
}
.statusLine:empty { display:none; }
.optionsBox, .draftBox, .doneBox {
  white-space:pre-wrap; background:var(--raised); border:1px solid var(--line);
  border-left:5px solid var(--signal); border-radius:5px;
  padding:1rem 1.2rem; margin-top:.4rem; font-size:1.02rem; line-height:1.6;
}
.doneBox { border-left-color:var(--deep); }

footer.page .who { color:var(--ink-soft); }
footer.page .stand {
  font-family:Archivo,system-ui,sans-serif; font-size:1.15rem; font-weight:600;
  line-height:1.42; color:var(--ink); letter-spacing:-.012em;
  max-width:46ch; margin-bottom:1.4rem; text-wrap:pretty;
}
footer.page p { margin-bottom:.6rem; }
.fine { font-family:"JetBrains Mono",ui-monospace,monospace; font-size:.75rem; color:var(--ink-mute); letter-spacing:.03em; }

/* ---------- hero call to action ---------- */
/* The old home page ended every section in prose and offered no next step.
   Someone having a hard week should not have to read to the bottom to find
   the door. */
a.btn { text-decoration:none; display:inline-flex; align-items:center; gap:.55rem; }
a.btn:hover { text-decoration:none; }
.cta { display:flex; flex-wrap:wrap; gap:.7rem; margin:1.7rem 0 .9rem; }
.cta .arrow { font-family:"JetBrains Mono",ui-monospace,monospace; }
.cta-note { font-size:.92rem; color:var(--ink-soft); margin:0; }

/* ---------- section labels ---------- */
.sec-label {
  font-family:"JetBrains Mono",ui-monospace,monospace; font-size:.72rem;
  letter-spacing:.14em; text-transform:uppercase; color:var(--ink-mute); margin:0 0 .55rem;
}

/* ---------- the tally ---------- */
/* One hundred employers. Sixty-one paid nothing. Drawn rather than stated,
   because the whole argument rests on this number and a sentence slides past.
   Filled squares are solid AND the rest are hollow, so the split survives
   greyscale, low vision and any colour blindness. */
.tally { margin:1.5rem 0 0; }
.tally-fig { display:flex; flex-wrap:wrap; gap:1.6rem 2.2rem; align-items:flex-start; }
.bignum {
  font-family:Archivo,system-ui,sans-serif; font-weight:800;
  font-size:clamp(3.2rem,11vw,5.4rem); line-height:.82; letter-spacing:-.045em;
  color:var(--deep); margin:0;
}
.bignum small { display:block; font-size:.9rem; font-weight:700; letter-spacing:.01em; line-height:1.35; color:var(--ink); margin-top:.6rem; max-width:14ch; }
.dots { display:grid; grid-template-columns:repeat(20,1fr); gap:4px; flex:1 1 20rem; max-width:30rem; }
.dots span { aspect-ratio:1/1; border-radius:2px; border:2px solid var(--line-firm); }
.dots span.on { background:var(--deep); border-color:var(--deep); }
@media (max-width:36rem) { .dots { grid-template-columns:repeat(10,1fr); max-width:18rem; } }
.tally-key { display:flex; flex-wrap:wrap; gap:.4rem 1.5rem; margin:.9rem 0 0; max-width:none; font-size:.92rem; color:var(--ink-soft); }
.tally + p { margin-top:1.5rem; }
.tally-key span { display:inline-flex; align-items:center; gap:.5rem; }
.tally-key i { width:.85rem; height:.85rem; border-radius:2px; border:2px solid var(--line-firm); flex:0 0 auto; }
.tally-key i.on { background:var(--deep); border-color:var(--deep); }

/* ---------- the thesis ---------- */
.thesis {
  font-family:Archivo,system-ui,sans-serif; font-weight:700;
  font-size:clamp(1.45rem,4vw,2.1rem); line-height:1.22; letter-spacing:-.025em;
  margin:0; max-width:22ch; text-wrap:balance;
}
.thesis em { font-style:normal; color:var(--signal); }
.thesis-sub { margin:1.1rem 0 0; color:var(--ink-soft); }

/* ---------- doors ---------- */
.cards { display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(14.5rem,1fr)); margin:1.3rem 0 0; }
.card {
  background:var(--raised); border:1px solid var(--line); border-top:4px solid var(--line-firm);
  border-radius:6px; padding:1.15rem 1.25rem 1.3rem; display:flex; flex-direction:column; gap:.5rem;
}
.card.open { border-top-color:var(--deep); }
.card.pending { border-top-color:var(--signal); }
.card h3 { margin:0; }
.card p { margin:0; max-width:none; font-size:1rem; color:var(--ink-soft); }
.chip {
  align-self:flex-start; font-family:"JetBrains Mono",ui-monospace,monospace;
  font-size:.68rem; font-weight:500; letter-spacing:.1em; text-transform:uppercase;
  padding:.22rem .5rem; border-radius:3px; border:1px solid var(--line-firm); color:var(--ink-mute);
}
.chip.live { background:var(--deep-bg); border-color:var(--deep); color:var(--deep); }
.chip.wait { background:var(--signal-bg); border-color:var(--signal); color:var(--signal); }

/* ---------- what happens, in order ---------- */
/* Numbered because it genuinely is a sequence, and the order is the part
   people are anxious about. */
.steps { list-style:none; counter-reset:s; padding:0; margin:1.3rem 0 0; display:grid; gap:1.15rem; }
.steps li { counter-increment:s; display:grid; grid-template-columns:2.1rem 1fr; gap:.95rem; align-items:start; margin:0; }
.steps li::before {
  content:counter(s); font-family:Archivo,system-ui,sans-serif; font-weight:800; font-size:.95rem;
  width:2.1rem; height:2.1rem; display:flex; align-items:center; justify-content:center;
  border-radius:50%; background:var(--ink); color:var(--ground);
}
.steps h3 { margin:0 0 .2rem; }
.steps p { margin:0; color:var(--ink-soft); }

/* ---------- what cannot happen ---------- */
.negs { list-style:none; padding:0; margin:1.2rem 0 0; border-top:1px solid var(--line); max-width:var(--measure); }
.negs li { margin:0; padding:.95rem 0 .95rem 2.1rem; border-bottom:1px solid var(--line); position:relative; color:var(--ink-soft); }
.negs li::before { content:""; position:absolute; left:.2rem; top:1.55rem; width:1.1rem; height:3px; background:var(--alert); border-radius:2px; }
.negs b { color:var(--ink); font-weight:700; }

/* ---------- proof strip ---------- */
/* Claims a reader can go and check. Numbers here are read out of the repo,
   not asserted. */
.proof {
  display:grid; grid-template-columns:repeat(auto-fit,minmax(8.5rem,1fr));
  border:1px solid var(--line); border-radius:6px; overflow:hidden;
  background:var(--raised); margin:1.3rem 0 0;
}
.proof div { padding:1.05rem 1.1rem; border-top:1px solid var(--line); border-right:1px solid var(--line); }
.proof div:nth-child(-n+4) { border-top:0; }
.proof b { display:block; font-family:Archivo,system-ui,sans-serif; font-size:1.85rem; font-weight:800; letter-spacing:-.03em; line-height:1; }
.proof span { display:block; margin-top:.4rem; font-size:.88rem; color:var(--ink-soft); line-height:1.4; }

/* ---------- the entrance ---------- */
/* The rule under the heading draws itself left to right: a cut being made.
   The blanket prefers-reduced-motion rule above switches all of this off. */
@keyframes cc-rise { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:none; } }
@keyframes cc-cut  { from { transform:scaleX(0); } to { transform:scaleX(1); } }
@media (prefers-reduced-motion: no-preference) {
  header.page .eyebrow { animation:cc-rise .45s ease-out both; }
  header.page h1       { animation:cc-rise .5s .05s ease-out both; }
  header.page .lede    { animation:cc-rise .5s .12s ease-out both; }
  header.page .hr      { animation:cc-cut .55s .2s cubic-bezier(.2,.7,.3,1) both; transform-origin:left center; }
}

/* ---------- screen-reader-only text ---------- */
.vh {
  position:absolute; width:1px; height:1px; padding:0; margin:-1px;
  overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0;
}

/* ---------- progress rail ---------- */
/* Four hidden sections revealing one at a time is disorienting, and the
   thing people are anxious about is exactly what comes next. So the whole
   path is visible from the start, including the fact that sending is last. */
.rail { list-style:none; padding:0; margin:0 0 1.7rem; display:flex; flex-wrap:wrap; gap:.45rem; }
.rail li {
  display:flex; align-items:center; gap:.5rem; margin:0;
  font-family:Archivo,system-ui,sans-serif; font-weight:600; font-size:.87rem;
  color:var(--ink-mute); background:var(--raised);
  border:1px solid var(--line); border-radius:100px; padding:.3rem .8rem .3rem .35rem;
}
.rail .n {
  width:1.5rem; height:1.5rem; flex:0 0 auto; border-radius:50%;
  border:2px solid var(--line-firm); display:flex; align-items:center;
  justify-content:center; font-size:.72rem; line-height:1;
}
.rail li[data-state="now"] { color:var(--ink); border-color:var(--ink); }
.rail li[data-state="now"] .n { background:var(--ink); color:var(--ground); border-color:var(--ink); }
.rail li[data-state="done"] { color:var(--deep); border-color:var(--deep); }
.rail li[data-state="done"] .n { background:var(--deep); color:var(--raised); border-color:var(--deep); }

/* ---------- starters ---------- */
/* Someone whose difficulty is typing should not have to type in order to
   say that typing is difficult. One tap fills the box, and it stays
   editable because these are starting points, not categories. */
.starters { list-style:none; display:flex; flex-wrap:wrap; gap:.5rem; padding:0; margin:.1rem 0 1.1rem; }
.starters li { margin:0; }
.starters button {
  font:inherit; font-size:.95rem; text-align:left; cursor:pointer;
  background:var(--raised); color:var(--ink); border:1px solid var(--line-firm);
  border-radius:100px; padding:.5rem .95rem; min-height:44px;
}
.starters button:hover { background:var(--sunk); }

/* ---------- the sent indicator ---------- */
/* It reads "nothing has been sent" for the entire session and only changes
   when something actually is. The reassurance has to be continuously true,
   not a sentence someone read once at the top. */
.sentinel {
  display:flex; align-items:center; gap:.6rem; margin:0 0 1.3rem;
  font-family:Archivo,system-ui,sans-serif; font-weight:700; font-size:.92rem;
  padding:.65rem .9rem; border-radius:5px;
  border:1px solid var(--deep); background:var(--deep-bg); color:var(--deep);
}
.sentinel .dot { width:.6rem; height:.6rem; border-radius:50%; background:currentColor; flex:0 0 auto; }
.sentinel[data-sent="yes"] { border-color:var(--signal); background:var(--signal-bg); color:var(--signal); }
.sentinel[data-sent="yes"] .dot { border-radius:1px; }

/* ---------- the poster ---------- */
/* A carrier reviewing this campaign has to be able to see the exact call to
   action a person reads before they text. Ours is printed and pinned to a wall,
   which is unverifiable from a browser, so the wall goes on the website. */
.poster {
  border: 3px solid var(--ink); border-radius: 6px; background: var(--raised);
  padding: clamp(1.4rem, 4vw, 2.2rem); margin: 1.4rem 0 0; max-width: 34rem;
}
.poster-kicker {
  font-family: Archivo, system-ui, sans-serif; font-weight: 700; font-size: 1.15rem;
  line-height: 1.25; margin: 0 0 1rem; text-wrap: balance;
}
.poster-do {
  font-family: Archivo, system-ui, sans-serif; font-weight: 800;
  font-size: clamp(1.5rem, 5vw, 2.1rem); letter-spacing: -.03em; line-height: 1.05;
  margin: 0 0 .2rem;
}
.poster-num {
  font-family: "JetBrains Mono", ui-monospace, monospace; font-weight: 500;
  font-size: clamp(1.3rem, 4.5vw, 1.7rem); letter-spacing: -.01em; margin: 0 0 1rem;
}
.poster-why { margin: 0 0 1.2rem; color: var(--ink-soft); max-width: none; }
.poster-legal {
  border-top: 1px solid var(--line); padding-top: .9rem; margin: 0;
  font-size: .82rem; line-height: 1.55; color: var(--ink-soft); max-width: none;
}
.poster-legal a { color: var(--ink); }

/* ---------- verbatim message blocks ---------- */
/* Shown exactly as sent, so what is quoted here can be compared against what
   arrives on a handset. */
.sms {
  font-family: "JetBrains Mono", ui-monospace, monospace; font-size: .82rem;
  line-height: 1.65; background: var(--sunk); border: 1px solid var(--line);
  border-left: 4px solid var(--signal); border-radius: 5px;
  padding: .9rem 1.05rem; margin: .5rem 0 1.2rem; white-space: pre-wrap;
  overflow-wrap: anywhere; max-width: none;
}
.sms-label {
  font-family: Archivo, system-ui, sans-serif; font-size: .74rem; font-weight: 700;
  letter-spacing: .09em; text-transform: uppercase; color: var(--ink-mute);
  margin: 1.2rem 0 0;
}

/* ---------- pickers ---------- */
select.picker {
  font:inherit; font-size:1.05rem; width:100%; max-width:28rem;
  padding:.7rem .8rem; margin:0 0 1.1rem;
  background:var(--raised); color:var(--ink);
  border:2px solid var(--line-firm); border-radius:5px; min-height:48px;
}
select.picker:focus-visible { outline:3px solid var(--focus); outline-offset:2px; }
</style>

