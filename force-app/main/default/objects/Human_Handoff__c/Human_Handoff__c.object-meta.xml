<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>The escape hatch. If the agent fails, the person who was already struggling must not be stuck with a machine. Reached by message, never by phone call.</description>
    <enableActivities>false</enableActivities>
    <enableFeeds>true</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Human Handoff</label>
    <nameField><label>Handoff Number</label><type>AutoNumber</type><displayFormat>HH-{00000}</displayFormat></nameField>
    <pluralLabel>Human Handoffs</pluralLabel>
    <sharingModel>Private</sharingModel>
</CustomObject>
