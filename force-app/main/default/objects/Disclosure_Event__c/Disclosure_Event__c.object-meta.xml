<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <compactLayoutAssignment>Disclosure_Event_Highlights</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Ledger of every time a preference was shown to someone, visible to the person it concerns. Added after self-critique: a preference that travels ahead of you is a disclosure made in your absence.</description>
    <enableActivities>false</enableActivities>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Disclosure Event</label>
    <nameField>
        <label>Disclosure Number</label>
        <type>AutoNumber</type>
        <displayFormat>DE-{00000}</displayFormat>
    </nameField>
    <pluralLabel>Disclosure Events</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Shown_To__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Shown_At__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Context__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Access_Preference__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
</CustomObject>
