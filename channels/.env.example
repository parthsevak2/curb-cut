# Copy to channels/.env and fill in. channels/.env is gitignored.
# Console -> Account Info. The SID is public; the Auth Token is a credential.
TWILIO_ACCOUNT_SID=AC8d94daa45db08c8b43fccc6ded60bbe4
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+12764959311

# Salt for hashing inbound numbers into Person_Handle__c.
# Any long random string. Changing it orphans existing handles.
HANDLE_SALT=

# Public site (Force.com Site in the org, guest access)
CURB_CUT_SITE=https://orgfarm-7a04c62cb9.my.salesforce-sites.com/curbcut
CURB_CUT_PRIVACY=https://orgfarm-7a04c62cb9.my.salesforce-sites.com/curbcut/privacy
CURB_CUT_TERMS=https://orgfarm-7a04c62cb9.my.salesforce-sites.com/curbcut/terms

# Inbound email channel (Salesforce Email Service)
CURB_CUT_EMAIL=curbcut@k-1cnb5a59o6bjnzp8kkwyshpgr8g0vwi9qhgl3p29zz9m62h9pw.gk-yij5suax.can96.apex.salesforce.com

# --- Slack -----------------------------------------------------------------
# From the Slack app's Basic Information page. Every request is signature
# checked before its body is parsed; without this the app refuses everything.
SLACK_SIGNING_SECRET=
# Bot token (xoxb-...) from OAuth & Permissions. Scopes: chat:write, im:history,
# commands. Without it the app can read a DM and not answer it.
SLACK_BOT_TOKEN=
# App-Level Token (xapp-..., scope connections:write) from Basic Information ->
# App-Level Tokens. With this set the relay uses Socket Mode: it dials out to
# Slack, so a laptop behind a home router runs it with no public URL and no
# tunnel. Create the app from channels/slack-manifest.json and Socket Mode is
# already enabled in the manifest.
SLACK_APP_TOKEN=
SLACK_PORT=3100
