# Copy to channels/.env and fill in. channels/.env is gitignored and must stay so.
# Every value here is deployment-specific: yours, not the project's.

# --- Twilio (text and voice; optional) -------------------------------------
# Console -> Account Info. The SID identifies the account; the Auth Token is a
# credential and never belongs in a committed file.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Your Twilio number, E.164. For US texting it must be registered for A2P 10DLC.
TWILIO_NUMBER=+1XXXXXXXXXX

# Salt for hashing inbound numbers into Person_Handle__c.
# Any long random string. Changing it orphans existing handles.
HANDLE_SALT=

# --- Your deployment's public identity -------------------------------------
# The Force.com Site in your org (guest access). The relay refuses to start
# without it, because the carrier disclosures quote these pages by URL.
CURB_CUT_SITE=https://YOUR-DOMAIN.my.salesforce-sites.com/curbcut
CURB_CUT_PRIVACY=https://YOUR-DOMAIN.my.salesforce-sites.com/curbcut/privacy
CURB_CUT_TERMS=https://YOUR-DOMAIN.my.salesforce-sites.com/curbcut/terms
# Where a person is pointed when the automated path fails them. Use a mailbox
# your access desk reads, never an individual's personal address.
CURB_CUT_SUPPORT_EMAIL=

# Inbound email channel: the address Salesforce generates in
# Setup -> Email Services -> CurbCutInbound in YOUR org.
CURB_CUT_EMAIL=

# --- Slack (optional) -------------------------------------------------------
# Create the app in your own workspace from channels/slack-manifest.json,
# then copy these from the app's Basic Information page. Every request is
# signature checked before its body is parsed.
SLACK_SIGNING_SECRET=
# Bot token (xoxb-...) from OAuth & Permissions. Scopes: chat:write, im:history,
# commands. Without it the app can read a DM and not answer it.
SLACK_BOT_TOKEN=
# App-Level Token (xapp-..., scope connections:write) from Basic Information ->
# App-Level Tokens. With this set the app uses Socket Mode: it dials out to
# Slack, so a machine behind a router runs it with no public URL and no tunnel.
SLACK_APP_TOKEN=
SLACK_PORT=3100
